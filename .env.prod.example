# Production template. Supply as process environment (e.g. Docker env_file),
# or copy to .env in the backend working directory. The app does not read
# .env.prod automatically. Replace every CHANGE_ME before use.
NODE_ENV=production
BACKEND_ROLE=all
# The supplied Compose file overrides this to api; a separate trusted worker is required.
PORT=3000
BASE_URL=https://YOUR_DOMAIN
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN
SKIP_INIT=false

# Database (these names match src/config/validation.schema.ts)
DB_HOST=db
DB_PORT=3306
DB_DATABASE=leverage
DB_USERNAME=leverage
DB_PASSWORD=CHANGE_ME
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT=10000
# Only needed when using the repository's docker-compose.yml database service
DB_ROOT_PASSWORD=CHANGE_ME

# Redis in the private Compose network (no host port). Supply a strong password;
# the same value is used by Bull, human-turn pub/sub, and maintenance leases.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

JWT_ACCESS_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_USE_ANOTHER_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# Bootstrap only on first single-instance HTTP startup; worker always excludes InitModule
INIT_SA_USERNAME=admin
INIT_SA_PASSWORD=CHANGE_ME
